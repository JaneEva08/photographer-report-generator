# Скопируйте этот файл в .env и заполните.

# Путь к JSON-ключу сервисного аккаунта (лежит в папке проекта)
GOOGLE_CREDENTIALS_PATH=service_account.json

# ID таблицы: часть ссылки между /d/ и /edit
# https://docs.google.com/spreadsheets/d/ВОТ_ЭТО_ID/edit
SPREADSHEET_ID=

# Имя фотографа в шапке отчёта (можно поменять в окне программы)
PHOTOGRAPHER_NAME=Ксения Толстых
